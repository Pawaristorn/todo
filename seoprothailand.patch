+    register_nav_menus([
+        'primary' => __('Primary Menu', 'seoprothailand'),
+        'footer'  => __('Footer Menu', 'seoprothailand'),
+    ]);
+}
+add_action('after_setup_theme', 'seoprothailand_setup');
