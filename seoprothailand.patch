+                emailField.classList.add('error');
+            }
+
+            if (!isValid) return;
+
+            // Show loading
+            submitBtn.disabled = true;
+            submitBtn.innerHTML = '<div class="spinner"></div><span>กำลังส่งข้อมูล...</span>';
+
+            // Simulate API call
